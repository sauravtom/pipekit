# CPU-only image for the development / fallback profile.
#
# Upstream ships only CUDA-based Dockerfiles (both Dockerfile and
# Dockerfile.arm64 are FROM nvidia/cuda), so the CPU profile needs its own:
# a slim Python base, CPU-only torch, and the +cpu build of the Qwen3-TTS
# ggml runtime. The GPU profile still builds straight from upstream.
FROM python:3.12-slim

# Pin matches S2S_REF in .env.example / docker-compose.yml.
ARG S2S_REF=cc37fe84fe08710e888ecc2eb5b468e41df74bca
ARG QWENTTS_VERSION=0.3.1
# Set automatically by BuildKit; used to pick the matching wheel.
ARG TARGETARCH

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        libportaudio2 \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch first. The default PyPI wheels drag in ~2.5 GB of CUDA
# libraries this profile can never use, and the version satisfies upstream's
# torch>=2.4.0 so pip keeps it rather than pulling the CUDA build later.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch torchaudio

# Must precede speech-to-speech: it depends on qwentts-cpp-python via
# faster-qwen3-tts[ggml], and the only wheels published to PyPI are CUDA
# (cu128) builds. The +cpu wheels live in a Hub dataset instead.
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) arch=x86_64 ;; \
      arm64) arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base=https://huggingface.co/datasets/andito/qwentts-cpp-python-wheels/resolve/main/whl/cpu; \
    wheel="qwentts_cpp_python-${QWENTTS_VERSION}%2Bcpu-py3-none-manylinux_2_34_${arch}.manylinux_2_35_${arch}.whl"; \
    pip install "${base}/${wheel}"

RUN pip install "speech-to-speech @ git+https://github.com/huggingface/speech-to-speech.git@${S2S_REF}"

# Same corpora the upstream image prefetches, so first boot does not reach out.
RUN python -c "import nltk; nltk.download('punkt_tab'); nltk.download('averaged_perceptron_tagger_eng')"

# Fail fast at build time if the install is not importable.
RUN speech-to-speech --help > /dev/null

CMD ["speech-to-speech", "--help"]
