# Copy to .env and edit. Compose reads .env automatically.

# Hugging Face token. Needed for gated repos and to avoid anonymous rate limits
# while pulling Parakeet / Qwen3-TTS / the GGUF on first boot.
HF_TOKEN=

# ----- LLM -------------------------------------------------------------------
# Any GGUF repo llama.cpp can serve with -hf.
LLM_MODEL=ggml-org/gemma-4-E4B-it-GGUF

# KV cache context, split across LLM_PARALLEL slots. This is the main VRAM dial.
# 24 GB (A10G / g5.xlarge):  32768
# 16 GB (T4 / g4dn.xlarge):  8192   and consider dropping --swa-full
LLM_CTX=32768
LLM_PARALLEL=2

# ----- CPU profile (development / fallback) ----------------------------------
# Only used with -f docker-compose.cpu.yml. GPU stays the default.
# The 4B default is unusably slow on CPU, so this profile drops to ~1B.
CPU_LLM_MODEL=ggml-org/gemma-3-1b-it-GGUF
CPU_LLM_CTX=4096
CPU_LLM_THREADS=4

# ----- Voice pipeline --------------------------------------------------------
# Concurrent realtime sessions. Each one loads its own STT/TTS handlers;
# connections past this limit are rejected with session_limit_reached.
NUM_PIPELINES=1

# VAD aggressiveness. Higher = less likely to trigger on background noise.
VAD_THRESHOLD=0.6

SYSTEM_PROMPT=You are a helpful voice assistant. Keep replies short and conversational.

# ----- Networking ------------------------------------------------------------
PIPEKIT_HOST_PORT=8765
LLM_HOST_PORT=8080

# ----- Build -----------------------------------------------------------------
# Pinned upstream commit. Override with `main` to track the tip.
S2S_REF=cc37fe84fe08710e888ecc2eb5b468e41df74bca
